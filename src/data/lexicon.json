{
  "version": 1,
  "updated_at": "2026-05-24",
  "matcher_notes": "All phrases match case-insensitively as substrings of the incoming client message after lowercasing. Phrases are stored lowercase. Word-boundary risk is low because phrases are multi-word and specific. Regex flexibility deferred to v2 (see voice/decisions.html dec-031).",
  "scoring_notes": "Severity controls badge color in the popup. low = ambient watch, medium = likely scope-expansion, high = clear unbilled-work ask. The matcher sums severities for the per-message score; messages with combined score >= 2 should be flagged prominently.",
  "categories": [
    {"id": "additive",            "label": "Additive — \"can you also...\"",                "weight": 1.0},
    {"id": "trivialize",          "label": "Trivializing — \"quick / small / tiny\"",       "weight": 0.9},
    {"id": "vague_future",        "label": "Vague-future — \"I was thinking...\"",          "weight": 0.7},
    {"id": "scope_shift",         "label": "Scope shift — \"actually let's pivot\"",        "weight": 1.2},
    {"id": "urgency",             "label": "Urgency — \"by tomorrow\" / \"ASAP\"",          "weight": 0.6},
    {"id": "relationship_leverage","label": "Relationship leverage — \"since you're here\"","weight": 1.0},
    {"id": "comparison_shame",    "label": "Comparison shame — \"the old designer...\"",    "weight": 1.0},
    {"id": "specification_creep", "label": "Spec creep — \"make it more...\"",              "weight": 0.8},
    {"id": "revision_cycle",      "label": "Revision cycle — \"just one more round\"",      "weight": 1.0},
    {"id": "deferred_spec",       "label": "Deferred spec — \"we forgot to mention\"",      "weight": 1.1},
    {"id": "technical_creep",     "label": "Technical creep — \"also needs to work on...\"","weight": 1.0},
    {"id": "assumption",          "label": "Assumption — \"I assume this includes...\"",    "weight": 0.9},
    {"id": "emotional_coercion",  "label": "Emotional coercion — \"we really need this\"",  "weight": 0.7},
    {"id": "fake_question",       "label": "Fake question — \"if you have a sec...\"",      "weight": 0.6},
    {"id": "favor_framing",       "label": "Favor framing — \"shouldn't take long\"",       "weight": 0.9}
