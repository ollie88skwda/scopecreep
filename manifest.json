{
  "manifest_version": 3,
  "name": "ScopeCreep Notary",
  "version": "0.2.0",
  "description": "Catches scope-expanding client messages before they cost you money.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://app.slack.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup/panel.html",
    "default_title": "ScopeCreep Notary"
  },
  "content_scripts": [
    {
      "matches": ["https://app.slack.com/*"],
      "js": ["src/content/slack.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/data/lexicon.json"],
      "matches": ["https://app.slack.com/*"]
    }
  ]
}
